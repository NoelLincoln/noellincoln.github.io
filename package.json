{
  "name": "noellincoln-portfolio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"blue,green\" \"bash -c 'cd backend && venv/bin/python manage.py runserver'\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('husky', {stdio: 'inherit'}) }\""
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,mjs,css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "three": "0.182.0",
    "stats-gl": {
      "three": "0.170.0"
    }
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "concurrently": "^10.0.3",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.29.1",
    "hint": "^7.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^21.0.0",
    "stylelint-csstree-validator": "^1.9.0",
    "stylelint-scss": "^3.21.0"
  }
}
